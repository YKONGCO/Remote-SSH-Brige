{
  "name": "remote-ssh-brige",
  "version": "0.6.4",
  "description": "Permission-controlled remote server access for AI agents over MCP and SSH",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "build:headless": "cargo build --manifest-path src-tauri/Cargo.toml --no-default-features --bin remote-ssh-brige-headless",
    "test:e2e": "node --test scripts/ssh-fixture-keys.test.mjs scripts/transfer-read-gate.test.mjs && node scripts/integration.mjs",
    "test:ui": "vitest run",
    "test:dev": "node --test scripts/dev-server.test.mjs",
    "format": "prettier --write src scripts/integration.mjs vite.config.ts README.md docs",
    "version:set": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-virtual": "^3.14.24",
    "@tauri-apps/api": "^2.10.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  }
}
